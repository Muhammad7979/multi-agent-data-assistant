# Optional: defaults to /api through the existing Vite development/preview proxy.
VITE_API_BASE_URL=/api
# For direct backend access, include /api (e.g. http://127.0.0.1:8000/api)
# and configure DATA_AGENT_CORS_ORIGINS in the backend process environment.
